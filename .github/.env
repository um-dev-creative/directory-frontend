# =============================================================================
# DIRECTORY FRONTEND — AI AGENT GOVERNANCE & RUNTIME CONFIGURATION
# =============================================================================
#
# This file serves two purposes:
#
#   1. RUNTIME TEMPLATE — Documents every environment variable required by the
#      application (BFF + Angular SSR). Copy to .env.local and fill real values.
#      In production all AUTH_*, ENCRYPT_*, REDIS_* and BACKBONE_* secrets are
#      injected by Vault via server/config/app.config.js.
#
#   2. AI AGENT GOVERNANCE — Sections 8.x define machine-readable rules for AI
#      coding agents (Claude Code, GitHub Copilot, etc.) that enforce business
#      logic integrity and architectural compliance. These keys do NOT affect
#      application runtime behavior; they are consumed exclusively by AI tooling.
#
# SECURITY NOTICE:
#   • Never commit real secrets to version control.
#   • VAULT_TOKEN must only be provided at runtime (CLI arg or CI/CD secret).
#   • All AUTH_* / ENCRYPT_* / REDIS_* values in production come from Vault.
#   • This file (with placeholder values) IS safe to commit.
#
# FILE STATUS:  ✅ Safe to commit (all secrets are placeholders)
# LAST UPDATED: 2026-04-03
# =============================================================================


# =============================================================================
# SECTION 1 — SERVER RUNTIME
# =============================================================================

# Application environment identifier.
# Consumed by: angular.json build configuration, server.js logging.
# Allowed values: dev | dev-cloud | qa | qa-cloud | production
ENVM=dev

# Node.js process environment.
# Allowed values: development | production
# Effect: NODE_ENV=production → enables proxy trust headers, disables TLS bypass.
# Effect: NODE_ENV=development → disables proxy trust, sets NODE_TLS_REJECT_UNAUTHORIZED=0.
NODE_ENV=development

# Verbose debug logging.
# Allowed values: true | false
# CONSTRAINT: Must be false in production — logging sensitive request data is forbidden.
DEBUG_MODE=false

# HTTPS server listening port.
# Default: 7001  |  Allowed range: 1024–65535
PORT=7001


# =============================================================================
# SECTION 2 — VAULT (Secret Manager)
# =============================================================================
# CONSTRAINT: server/config/app.config.js is the SOLE consumer of Vault.
#             Do NOT add Vault client calls anywhere else in the codebase.
# CONSTRAINT: These three variables are the only secrets that may be set in .env
#             for local development. All other secrets must come from Vault in
#             non-development environments.

# Vault server base URL.
VAULT_URL=https://vault.example.com

# Path to this application's secrets inside Vault (KV v2).
# Template: PRX/data/directory-frontend/<ENVM>
VAULT_PATH=PRX/data/directory-frontend/${ENVM}

# Vault access token — provided at runtime via CLI arg (--vaultToken) or CI secret.
# NEVER hardcode this value.
# VAULT_TOKEN=<injected-at-runtime>


# =============================================================================
# SECTION 3 — DIRECTORY BACKEND OAuth
# =============================================================================
# These variables configure the BFF → Directory Backend service-to-service
# OAuth 2.0 flow (client credentials / resource-owner password credentials).
#
# CONSTRAINT: These variables must NEVER be read inside any Angular (src/) file.
# CONSTRAINT: They must NEVER appear in any HTTP response sent to the browser.
# Consumer: server/shared/oauth-common-function.js
#           server/controller/directory-backend-auth.controller.js
#           server/controller/multimedia.controller.js

# UUID v4 — the application ID registered in Backbone for this frontend.
APPLICATION_ID=<uuid-v4>

# OAuth 2.0 client credentials for the Directory Backend service account.
AUTH_CLIENT_ID=<directory-backend-client-id>
AUTH_CLIENT_SECRET=<directory-backend-client-secret>
AUTH_GRANT_TYPE=password

# Token authentication type.
# Allowed values: OPAQUE | JWT
AUTH_AUTHENTICATION_TYPE=JWT

# Keycloak / OAuth authorization server token endpoint.
AUTH_SERVER_URI=https://keycloak.example.com/realms/<realm>/protocol/openid-connect/token

# Service account credentials used to obtain tokens on behalf of the frontend.
AUTH_USER_ALIAS=<service-account-username>
AUTH_USER_PASSWORD=<service-account-password>

# JSON map: application name → base URL for Directory Backend services.
# Format: {"directory-backend":"https://host:port"}
# Consumed by: getApiEndpoint() in server/shared/common-function.js
API_SERVICE_DIRECTORY_MAP={"directory-backend":"https://directory-backend.example.com"}

# Relative BFF path that triggers the Directory access-token flow.
# Must match INNER_ACCESS_TOKEN_PATH in server/config/constants.util.js.
API_SERVICE_DIRECTORY_SESSION_RELATIVE_PATH=/drb/api/v1/auth/access-token


# =============================================================================
# SECTION 4 — BACKBONE OAuth
# =============================================================================
# These variables configure the BFF → Backbone service-to-service OAuth flow.
#
# CONSTRAINT: These variables must NEVER be read inside any Angular (src/) file.
# CONSTRAINT: They must NEVER appear in any HTTP response sent to the browser.
# Consumer: server/controller/backbone.controller.js

# JSON map: "backbone" → base URL for Backbone REST services.
# Format: {"backbone":"https://host:port"}
BACKBONE_API_SERVICE_MAP={"backbone":"https://backbone.example.com"}

# OAuth 2.0 client credentials for the Backbone service account.
BACKBONE_AUTH_CLIENT_ID=<backbone-client-id>
BACKBONE_AUTH_CLIENT_SECRET=<backbone-client-secret>
BACKBONE_AUTH_GRANT_TYPE=password

# Token authentication type.
# Allowed values: OPAQUE | JWT
BACKBONE_AUTH_AUTHENTICATION_TYPE=OPAQUE

# Keycloak / OAuth authorization server token endpoint for Backbone.
BACKBONE_AUTH_SERVER_URI=https://keycloak.example.com/realms/<realm>/protocol/openid-connect/token

# Backbone service account credentials.
BACKBONE_AUTH_USER_ALIAS=<backbone-service-account-username>
BACKBONE_AUTH_USER_PASSWORD=<backbone-service-account-password>


# =============================================================================
# SECTION 5 — ENCRYPTION
# =============================================================================
# AES encryption keys used by CryptoJS to encrypt user passwords before
# forwarding them to Backbone and Directory Backend.
#
# CONSTRAINT: ENCRYPT_KEY must be exactly 32 characters (256-bit key for AES-256).
# CONSTRAINT: ENCRYPT_IV must be exactly 16 characters (128-bit IV for AES).
# CONSTRAINT: Changing these values invalidates ALL in-flight encrypted payloads.
#             Any rotation must be coordinated simultaneously with all backend
#             services that decrypt the values.
# CONSTRAINT: These values must NEVER appear in logs, HTTP responses, or headers.
# Consumer: server/controller/backbone.controller.js
#           server/controller/directory-backend-auth.controller.js
#           server/controller/directory-backend-register.controller.js
#           server/controller/directory-backend-create-user.controller.js

ENCRYPT_KEY=<32-char-aes256-key-exactly-32-chars>
ENCRYPT_IV=<16-char-aes-iv-16ch>


# =============================================================================
# SECTION 6 — REDIS SESSION STORE
# =============================================================================
# Redis is the primary distributed session store for backbone and directory
# session tokens (TTL-based, keyed by userId with prefix "session:").
#
# CONSTRAINT: The fallback to in-memory Map (server/shared/redis-session-store.js)
#             is intentional and MUST NOT be removed. It guarantees single-node
#             availability when Redis is temporarily unreachable.
# CONSTRAINT: Redis is also used for distributed OAuth token caching
#             (prefix "oauth_token:") and distributed locking (prefix "lock:").
# CONSTRAINT: REDIS_URL is required for multi-instance deployments. Without it,
#             sessions are NOT shared across pods/instances.
# Consumer: server/shared/redis-client.js
#           server/shared/redis-session-store.js
#           server/shared/redis-lock.js
#           server/proxy/oauth-client.js
#           server/controller/backbone.controller.js

REDIS_URL=redis.example.com
REDIS_PORT=6379
REDIS_USERNAME=<redis-username>
REDIS_PASSWORD=<redis-password>


# =============================================================================
# SECTION 7 — PROXY (optional — corporate network)
# =============================================================================
# Uncomment if outbound HTTP traffic from the BFF routes through a corporate
# forward proxy. Consumed via server/config/custom-environment-variables.yaml.

# HTTP_PROXY_HOST=proxy.internal.example.com
# HTTP_PROXY_PORT=8080
# API_SERVICE_REQUEST_TIMEOUT=30000


# =============================================================================
# SECTION 8 — AI AGENT GOVERNANCE RULES
# =============================================================================
# The variables below are consumed by AI coding agents to enforce architectural
# compliance and prevent business logic regressions.
# They have NO effect on application runtime behavior.
#
# Agents MUST read and respect these rules before proposing any code change.
# The rules in CLAUDE.md (human-readable narrative) and this file (machine-
# readable key=value) are authoritative and complementary — keep them in sync.
# =============================================================================


# ─── 8.1 PROTECTED FILES ─────────────────────────────────────────────────────
# Files and directories that AI agents MUST NEVER read-to-modify, edit, or
# delete under any circumstance, even if explicitly requested by the user.
# Rationale: ssl/ contains TLS certificates; dist/ is build output;
#            Dockerfile and docker-entrypoint.sh define the container contract;
#            server/config/app.config.js is the Vault bootstrap — modifying it
#            can expose secrets or break the entire configuration chain.

AI_PROTECTED_FILES=ssl/,dist/,Dockerfile,docker-entrypoint.sh,server/config/app.config.js


# ─── 8.2 BFF ARCHITECTURE ENFORCEMENT ───────────────────────────────────────
# The BFF (Backend for Frontend) pattern is the core architectural constraint
# of this project. Angular code MUST NEVER communicate directly with Java
# backend services.
#
# FORBIDDEN:  Direct HTTP calls from src/ to any Java backend URL.
# REQUIRED:   All outbound HTTP from Angular must use HttpService.
# REQUIRED:   All URLs must be defined as constants in DFC or environment.ts.
# REQUIRED:   Zero hardcoded URL strings anywhere in src/.
# REQUIRED:   New backend integrations require a new BFF route + controller.

AI_ARCH_BFF_REQUIRED=true
AI_ARCH_ANGULAR_HTTP_ENTRY_POINT=@core/services/http.service.ts
AI_ARCH_URL_SOURCE=DFC_CONSTANTS|environment.ts
AI_ARCH_HARDCODED_URLS=forbidden
AI_ARCH_DIRECT_BACKEND_FROM_ANGULAR=forbidden


# ─── 8.3 AUTHENTICATION & SESSION INTEGRITY ──────────────────────────────────
# Rules protecting the multi-leg auth handshake:
#   Backbone OAuth → Backbone session → Directory OAuth → Directory session
#
# FORBIDDEN:  Modifying the session token handshake sequence.
# FORBIDDEN:  Bypassing AES encryption before forwarding passwords to backends.
# FORBIDDEN:  Removing the Redis in-memory fallback session store.
# FORBIDDEN:  JWT signature verification on the BFF side (decode-only is correct).
# REQUIRED:   Session TTL must derive from backboneSessionExpiresAt (not hardcoded).
# REQUIRED:   Distributed lock (redis-lock.js) must wrap all concurrent token
#             refresh operations to prevent race conditions.
# REQUIRED:   Domain validation (schemesList + domainsList) must precede every
#             upstream proxy call in every BFF controller.

AI_AUTH_ENCRYPT_ALGO=AES-CryptoJS
AI_AUTH_SESSION_STORE=Redis+MemoryFallback
AI_AUTH_JWT_STRATEGY=decode-only-no-verify
AI_AUTH_DOMAIN_WHITELIST=directory-backend,backbone-rest,prx-qa.backbone.tst,prx-qa.manager.tst,localhost
AI_AUTH_CONCURRENT_LOCK=redis-lock.js
AI_AUTH_SESSION_TTL_SOURCE=backboneSessionExpiresAt
AI_AUTH_REDIS_FALLBACK_REMOVAL=forbidden
AI_AUTH_HANDSHAKE_MODIFICATION=forbidden


# ─── 8.4 ANGULAR COMPONENT RULES ─────────────────────────────────────────────
# REQUIRED:   standalone: true on every component — NgModules are forbidden.
# REQUIRED:   Dependency injection via inject() — not constructor parameters
#             (except when extending a class that requires constructor injection).
# REQUIRED:   New Angular control flow syntax only: @if, @for, @let.
# FORBIDDEN:  *ngIf, *ngFor, *ngSwitch structural directives.
# REQUIRED:   Explicit imports[] array in every @Component decorator.
# REQUIRED:   Use | translate pipe when the i18n key already exists in
#             src/assets/i18n/. New strings may be hardcoded temporarily with
#             a // TODO: i18n comment.

AI_ANGULAR_STANDALONE_ONLY=true
AI_ANGULAR_DI_METHOD=inject()
AI_ANGULAR_CONTROL_FLOW=@if|@for|@let
AI_ANGULAR_FORBIDDEN_DIRECTIVES=*ngIf,*ngFor,*ngSwitch
AI_ANGULAR_NGMODULE=forbidden
AI_ANGULAR_TRANSLATE_PIPE=required-when-key-exists
AI_ANGULAR_TRANSLATE_TODO_COMMENT=// TODO: i18n


# ─── 8.5 STATE MANAGEMENT RULES ──────────────────────────────────────────────
# REQUIRED:   NgRx for all cross-component / global state.
# FORBIDDEN:  Alternative state libraries (MobX, Akita, NGXS, plain services
#             with BehaviorSubject as global state, etc.).
# REQUIRED:   Angular Signals for component-local state only.
# REQUIRED:   Feature store file structure must include all six files.
# REQUIRED:   Action type string convention: "[Feature] Verb Noun".

AI_STATE_GLOBAL=NgRx
AI_STATE_LOCAL=Signals
AI_STATE_NGRX_ACTION_PATTERN=[Feature] Verb Noun
AI_STATE_NGRX_FEATURE_FILES=state.ts,actions.ts,reducer.ts,effects.ts,selectors.ts,store.service.ts
AI_STATE_ALTERNATIVE_LIBRARIES=forbidden


# ─── 8.6 SSR COMPATIBILITY ───────────────────────────────────────────────────
# The application uses Angular SSR (@angular/ssr) with an Express.js host.
# Browser-only globals are unavailable during server-side rendering.
#
# REQUIRED:   Wrap any access to browser globals with isPlatformBrowser() or
#             delegate to StorageMockService.
# REQUIRED:   Mark SSR-incompatible code blocks with: // SSR: browser-only
# FORBIDDEN:  Direct access to window, document, localStorage, sessionStorage
#             without an isPlatformBrowser() guard.

AI_SSR_BROWSER_GUARD=isPlatformBrowser|StorageMockService
AI_SSR_FORBIDDEN_GLOBALS=window,document,localStorage,sessionStorage
AI_SSR_MARKER_COMMENT=// SSR: browser-only


# ─── 8.7 DEPENDENCY GOVERNANCE ───────────────────────────────────────────────
# FORBIDDEN:  The `request` npm package — abandoned, multiple unpatched CVEs
#             (GHSA-p8p7-x288-28g6, GHSA-fjxv-7rqg-78g4, etc.).
# REQUIRED:   Use native fetch or axios for all outbound HTTP.
# REQUIRED:   Run `npm audit --audit-level=high` before any dependency-touching PR.
# REQUIRED:   Use `npm ci` in CI/CD pipelines — never `npm install`.
# REQUIRED:   When upgrading Angular, update ALL @angular/* packages at once.
# FORBIDDEN:  `npm audit fix --force` without a dedicated branch and passing tests.
# REQUIRED:   New packages must have a release within the last 12 months.

AI_DEP_FORBIDDEN_PACKAGES=request
AI_DEP_ALLOWED_HTTP_CLIENTS=fetch|axios
AI_DEP_AUDIT_REQUIRED=true
AI_DEP_AUDIT_LEVEL=high
AI_DEP_CI_INSTALL_COMMAND=npm ci
AI_DEP_AUDIT_FIX_FORCE=forbidden-without-branch-and-tests
AI_DEP_ANGULAR_UPDATE_STRATEGY=all-at-once-same-patch


# ─── 8.8 TESTING RULES ───────────────────────────────────────────────────────
# REQUIRED:   *.spec.ts files must live in the same directory as the file tested.
# FORBIDDEN:  Real HTTP calls in unit tests — mock all external dependencies.
# REQUIRED:   Standard test command (exact string, used in CI):
#               ng test --code-coverage --no-watch --browsers ChromeHeadlessNoSandbox
# REQUIRED:   Minimum coverage threshold as configured in karma.conf.js —
#             do not lower thresholds.

AI_TEST_SPEC_COLOCATION=true
AI_TEST_REAL_HTTP_CALLS=forbidden
AI_TEST_COMMAND=ng test --code-coverage --no-watch --browsers ChromeHeadlessNoSandbox
AI_TEST_COVERAGE_THRESHOLD=as-configured-in-karma.conf.js


# ─── 8.9 PATH ALIAS RULES ────────────────────────────────────────────────────
# REQUIRED:   Always use TypeScript path aliases for cross-module imports.
# FORBIDDEN:  Relative import paths that ascend more than two directory levels
#             (e.g., ../../../services/foo is forbidden).
# Aliases (defined in tsconfig.json):
#   @app/*    → src/app/*
#   @core/*   → src/app/core/*
#   @shared/* → src/app/shared/*
#   @env/*    → src/environments/*

AI_ALIAS_APP=@app/*→src/app/*
AI_ALIAS_CORE=@core/*→src/app/core/*
AI_ALIAS_SHARED=@shared/*→src/app/shared/*
AI_ALIAS_ENV=@env/*→src/environments/*
AI_ALIAS_MAX_RELATIVE_DEPTH=2
AI_ALIAS_DEEP_RELATIVE_IMPORTS=forbidden


# ─── 8.10 BFF ROUTE & PROXY INTEGRITY ────────────────────────────────────────
# FORBIDDEN:  Adding routes that skip domain/scheme validation
#             (schemesList + domainsList checks in every controller).
# FORBIDDEN:  Removing or bypassing URL-rewrite logic in server/config/config.json.
# REQUIRED:   New BFF API routes must be registered in the appropriate
#             server/routes/*.routes.js file.
# REQUIRED:   New proxy targets must be added to config.json following the
#             existing directoryBackendProxyConfig pattern.
# FORBIDDEN:  Exposing internal service base URLs (values in API_SERVICE_*_MAP)
#             in any HTTP response or header returned to the Angular client.
# FORBIDDEN:  Modifying the rate-limit middleware (currently: 10 000 req / 15 min).

AI_BFF_DOMAIN_VALIDATION=schemesList+domainsList
AI_BFF_URL_REWRITE_REMOVAL=forbidden
AI_BFF_INTERNAL_URL_EXPOSURE=forbidden
AI_BFF_RATE_LIMIT_REMOVAL=forbidden
AI_BFF_RATE_LIMIT_WINDOW_MS=900000
AI_BFF_RATE_LIMIT_MAX=10000


# ─── 8.11 ENCRYPTION KEY PROTECTION ─────────────────────────────────────────
# FORBIDDEN:  Logging ENCRYPT_KEY, ENCRYPT_IV, or any plaintext password value.
# FORBIDDEN:  Sending ENCRYPT_KEY or ENCRYPT_IV in any HTTP response or header.
# FORBIDDEN:  Changing the encryption algorithm (AES via CryptoJS) without
#             coordinating a simultaneous rotation with all backend services.
# REQUIRED:   Every password forwarded to Backbone or Directory Backend must be
#             encrypted with CryptoJS.AES.encrypt(password, cKey, { iv }) before
#             inclusion in the request body.

AI_CRYPTO_LOG_FORBIDDEN=ENCRYPT_KEY,ENCRYPT_IV,plaintext-password
AI_CRYPTO_ALGO_CHANGE=requires-simultaneous-backend-coordination
AI_CRYPTO_PASSWORD_FORWARD_UNENCRYPTED=forbidden


# ─── 8.12 LOGGING CONSTRAINTS ────────────────────────────────────────────────
# FORBIDDEN:  Logging bearer tokens, session tokens, OAuth client secrets,
#             passwords, or Vault tokens at any log level.
# REQUIRED:   Use the string [REDACTED] as placeholder when referencing secret
#             values in log messages (see existing getBearerToken log as example).
# FORBIDDEN:  console.log / console.error in production BFF code paths —
#             use the Winston logger instance (appConfig.getLoggerApp()).
# EXCEPTION:  console.error is acceptable inside catch blocks during app
#             bootstrapping (before the logger is initialized).

AI_LOG_FORBIDDEN_VALUES=bearerToken,clientSecret,plaintext-password,VAULT_TOKEN,session-token
AI_LOG_SECRET_PLACEHOLDER=[REDACTED]
AI_LOG_CONSOLE_IN_BFF=forbidden-use-winston-logger
AI_LOG_BOOTSTRAP_EXCEPTION=console.error-allowed-before-logger-init


# ─── 8.13 REQUEST SIZE & UPLOAD LIMITS ───────────────────────────────────────
# FORBIDDEN:  Removing or relaxing express-rate-limit middleware.
# FORBIDDEN:  Increasing JSON body size limit above 5 MB without architecture review.
# FORBIDDEN:  Removing or increasing the multer file size limit above 10 MB
#             for profile image uploads without architecture review.
# Consumer:   server.js (express.json limit), server/routes/multimedia.routes.js

AI_REQUEST_BODY_MAX_MB=5
AI_UPLOAD_FILE_MAX_MB=10
AI_BODY_LIMIT_INCREASE=requires-architecture-review
AI_UPLOAD_LIMIT_INCREASE=requires-architecture-review


# ─── 8.14 SSL / TLS POLICY ───────────────────────────────────────────────────
# FORBIDDEN:  NODE_TLS_REJECT_UNAUTHORIZED=0 when NODE_ENV=production.
# ALLOWED:    NODE_TLS_REJECT_UNAUTHORIZED=0 only in non-production environments
#             (behaviour already gated by the if-block in server.js line 1-3).
# FORBIDDEN:  Any modification to certificate files under ssl/.
# REQUIRED:   HTTPS server must always be started using ssl/backbone.key and
#             ssl/backbone.crt — plain HTTP server binding is forbidden.

AI_TLS_REJECT_UNAUTHORIZED_IN_PROD=forbidden
AI_TLS_CERT_MODIFICATION=forbidden
AI_HTTP_PLAIN_SERVER=forbidden


# ─── 8.15 I18N / LANGUAGE POLICY ─────────────────────────────────────────────
# Default UI language: Spanish (es).
# Translation files: src/assets/i18n/
#
# REQUIRED:   Use | translate pipe for any user-visible text when the i18n key
#             already exists in the translation files.
# ALLOWED:    Hardcoded strings for new/prototype UI with // TODO: i18n comment.
# FORBIDDEN:  Removing existing translation keys from i18n JSON files.
# FORBIDDEN:  Changing the default language from Spanish without explicit approval.

AI_I18N_DEFAULT_LANGUAGE=es
AI_I18N_TRANSLATION_DIR=src/assets/i18n/
AI_I18N_KEY_REMOVAL=forbidden
AI_I18N_DEFAULT_LANGUAGE_CHANGE=requires-explicit-approval

