{
  "name": "directory-frontend",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start-dev:win": "node server.js --ssl true --ssl-key ssl/backbone.key --ssl-cert ssl/backbone.crt --vaultToken %VAULT_TOKEN% --vaultUrl %VAULT_URL% --vaultPath PRX/data/directory-frontend/%ENVM% --debugMode %DEBUG_MODE%",
    "start-dev:unix": "node server.js --ssl true --ssl-key ssl/backbone.key --ssl-cert ssl/backbone.crt --vaultToken $VAULT_TOKEN --vaultUrl $VAULT_URL --vaultPath PRX/data/directory-frontend/$ENVM --debugMode $DEBUG_MODE",
    "build": "cross-env ng build --configuration=$ENVM",
    "build:ssr": "cross-env-shell \"ng build --configuration $ENVM && ng run directory-frontend:server\"",
    "watch": "ng build --watch --configuration development",
    "watch:ssr": "ng build --watch --configuration development && ng run directory-frontend:server --watch",
    "dev:win": "concurrently \"npm run watch:ssr\" \"npm run start-dev:win\"",
    "dev:unix": "concurrently \"npm run watch:ssr\" \"npm run start-dev:unix\"",
    "test": "ng test --code-coverage --no-watch --browsers ChromeHeadlessNoSandbox",
    "test:browser": "ng test --code-coverage",
    "server:ssr:directory-frontend": "node dist/directory-frontend/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.3",
    "@angular/common": "^20.3.3",
    "@angular/compiler": "^20.3.3",
    "@angular/core": "^20.3.3",
    "@angular/forms": "^20.3.3",
    "@angular/platform-browser": "^20.3.3",
    "@angular/platform-browser-dynamic": "^20.3.3",
    "@angular/platform-server": "^20.3.3",
    "@angular/router": "^20.3.3",
    "@angular/ssr": "^20.3.4",
    "@ngrx/effects": "^20.0.1",
    "@ngrx/store": "^20.0.1",
    "@ngrx/store-devtools": "^20.0.1",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "agentkeepalive": "^4.6.0",
    "ajv": "^8.17.1",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "compression": "^1.7.5",
    "config": "^3.3.12",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-http-context": "^1.2.4",
    "express-rate-limit": "^7.5.0",
    "form-data": "^4.0.4",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.11.18",
    "logform": "^2.7.0",
    "multer": "^2.0.0",
    "node-vault-client": "^1.0.1",
    "redis": "^4.7.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "yargs": "^17.7.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.4",
    "@angular/cli": "^20.3.4",
    "@angular/compiler-cli": "^20.3.3",
    "@tailwindcss/cli": "^4.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jasmine": "~5.1.5",
    "@types/node": "^22.10.7",
    "concurrently": "^9.1.2",
    "cross-env": "^10.0.0",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "bcrypt",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
