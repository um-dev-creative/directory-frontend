{
  "directoryBackendProxyConfig": [
    {
      "applicationName": "directory-backend",
      "matchOn": {
        "startWith": "/drb/api/v1"
      },
      "urlRewrite": {
        "from": "/drb/api/v1",
        "to": "/directory-backend/api/v1"
      }
    }
  ],
  "authDirectoryBackendProxyConfig": [
    {
      "applicationName": "directory-backend",
      "matchOn": {
        "startWith": "/auth/drb/api/v1/auth"
      },
      "urlRewrite": {
        "from": "/auth/drb/api/v1/auth",
        "to": "/directory-backend/api/v1/auth"
      }
    }
  ],
  "backboneProxyConfig": [
    {
      "applicationName": "backbone",
      "matchOn": {
        "startWith": "/bkd/api/v1"
      },
      "urlRewrite": {
        "from": "/bkd/api/v1",
        "to": "/backbone/api/v1"
      }
    }
  ]
}
